<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>edu.gatech.mbsec.adapter.magicdraw</groupId>
    <artifactId>oslc4jmagicdraw-parent</artifactId>
    <version>1.1.0</version>
    <relativePath>..</relativePath>
  </parent>
  <artifactId>oslc4j-magicdraw-repo-magicdraw-2026</artifactId>
  <packaging>jar</packaging>
  <name>OSLC MagicDraw 2026 SysML v1 Repository</name>

  <dependencies>
    <dependency>
      <groupId>edu.gatech.mbsec.adapter.magicdraw</groupId>
      <artifactId>oslc4j-magicdraw-repo-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>edu.gatech.mbsec.adapter.magicdraw</groupId>
      <artifactId>oslc4j-magicdraw-resources</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- These proprietary SDK JARs come from the local 2026 product install. -->
    <dependency>
      <groupId>com.nomagic.magicdraw</groupId>
      <artifactId>core</artifactId>
      <version>${magicdraw.version}</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/lib/core-${magicdraw.version}.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.nomagic.magicdraw</groupId>
      <artifactId>common</artifactId>
      <version>${magicdraw.version}</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/lib/common-${magicdraw.version}.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.nomagic.magicdraw</groupId>
      <artifactId>uml2</artifactId>
      <version>${magicdraw.version}</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/lib/com.nomagic.magicdraw.uml2-${magicdraw.version}.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.nomagic.magicdraw</groupId>
      <artifactId>foundation</artifactId>
      <version>${magicdraw.version}</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/lib/com.nomagic.magicdraw.foundation-${magicdraw.version}.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.nomagic.magicdraw</groupId>
      <artifactId>modeling</artifactId>
      <version>${magicdraw.version}</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/lib/com.nomagic.magicdraw.modeling-${magicdraw.version}.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.nomagic.magicdraw</groupId>
      <artifactId>foundation-runtime</artifactId>
      <version>${magicdraw.version}</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/lib/com.dassault_systemes.modeler.foundation-${magicdraw.version}.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.nomagic.magicdraw</groupId>
      <artifactId>utils</artifactId>
      <version>${magicdraw.version}</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/lib/com.nomagic.utils-${magicdraw.version}.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.nomagic.magicdraw</groupId>
      <artifactId>core-diagram</artifactId>
      <version>${magicdraw.version}</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/lib/com.nomagic.magicdraw.core.diagram-${magicdraw.version}.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.nomagic.magicdraw</groupId>
      <artifactId>foundation-diagram</artifactId>
      <version>${magicdraw.version}</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/lib/com.dassault_systemes.modeler.foundation.diagram-${magicdraw.version}.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.nomagic.magicdraw</groupId>
      <artifactId>jmi</artifactId>
      <version>1.0</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/lib/javax.jmi-1.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.nomagic.magicdraw.sysml</groupId>
      <artifactId>sysml-plugin</artifactId>
      <version>${magicdraw.version}</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/plugins/com.nomagic.magicdraw.sysml/sysml-${magicdraw.version}.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.nomagic.magicdraw.sysml</groupId>
      <artifactId>sysml-compatibility-api</artifactId>
      <version>${magicdraw.version}</version>
      <scope>system</scope>
      <systemPath>${magicdraw.installdir}/plugins/com.nomagic.requirements/lib/com.nomagic.magicdraw.sysml-${magicdraw.version}.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- This module is selected only for MagicDraw builds. Keep the product-hosted
         integration test attached to the same profile so ordinary standalone builds
         do not need the proprietary installation. -->
    <profile>
      <id>magicdraw-2026x-r1-community</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.7.1</version>
            <executions>
              <execution>
                <id>magicdraw-integration-test-classpath</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>build-classpath</goal>
                </goals>
                <configuration>
                  <includeScope>test</includeScope>
                  <outputFile>${project.build.directory}/magicdraw-test-classpath.txt</outputFile>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.5.2</version>
            <configuration>
              <systemPropertyVariables>
                <magicdraw.home>${magicdraw.installdir}</magicdraw.home>
                <magicdraw.version>${magicdraw.version}</magicdraw.version>
                <magicdraw.module.basedir>${project.basedir}</magicdraw.module.basedir>
                <magicdraw.test.classpath>${project.build.directory}/magicdraw-test-classpath.txt</magicdraw.test.classpath>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
